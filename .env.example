# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
# Database Configuration (Supabase Cloud - Phase Database)
SUPABASE_DB_URL=jdbc:postgresql://<supabase-host>:5432/<database-name>
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=<your-supabase-password>
# JWT Security Configuration (Phase Authentication)
JWT_SECRET=<your-256-bit-secret-key>
JWT_EXPIRATION_MS=86400000
# AI Service Configuration (Phase AI Integration)
GEMINI_API_KEY=<your-api-key>